# Copy to .env.local and fill in from your Supabase project:
#   Project Settings -> API
#
# Both values are safe in the client bundle. The anon key is public by design;
# row-level security is what protects the data, which is why the policies in
# supabase/migrations are the real security boundary and are tested in
# supabase/tests/rls_test.sql.
#
# Leave these unset to run the app fully local, with no backend.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
